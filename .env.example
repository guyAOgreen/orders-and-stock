# Copy to .env for local development. Local-only values; never reuse them elsewhere.

# PostgreSQL container (read by docker-compose.yml). The test database is
# named ${POSTGRES_DB}_test.
POSTGRES_USER=orders_stock
POSTGRES_PASSWORD=orders_stock
POSTGRES_DB=orders_stock

# Application (read by orders_stock.config). Must match the values above.
DATABASE_URL=postgresql+psycopg://orders_stock:orders_stock@localhost:5433/orders_stock
TEST_DATABASE_URL=postgresql+psycopg://orders_stock:orders_stock@localhost:5433/orders_stock_test
LOG_LEVEL=INFO
