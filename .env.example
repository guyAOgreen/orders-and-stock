# Copy to .env for local development. Local-only values; never reuse them elsewhere.

# PostgreSQL container (read by docker-compose.yml). The test database is
# named ${POSTGRES_DB}_test. The application containers build their own
# DATABASE_URL from these values, pointing at the `postgres` service.
POSTGRES_USER=orders_stock
POSTGRES_PASSWORD=orders_stock
POSTGRES_DB=orders_stock

# Native application (read by orders_stock.config). Must match the values
# above; the host port is 5433, the port docker-compose.yml publishes.
DATABASE_URL=postgresql+psycopg://orders_stock:orders_stock@localhost:5433/orders_stock
TEST_DATABASE_URL=postgresql+psycopg://orders_stock:orders_stock@localhost:5433/orders_stock_test
# Native and containers alike: Compose forwards these two into the containers.
LOG_LEVEL=INFO
# How long the stock worker waits between polls when there is no pending work.
WORKER_POLL_INTERVAL_SECONDS=1.0
